<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

	<targets>
		<!-- Write logs to a daily file -->
		<target xsi:type="File"
				name="logfile"
				fileName="${basedir}/logs/renttrack-${shortdate}.log"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}"
				keepFileOpen="false" />

		<!-- Display logs in the terminal during development -->
		<target xsi:type="Console"
				name="console"
				layout="${longdate}|${level:uppercase=true}|${logger}|${message} ${exception:format=tostring}" />
	</targets>

	<rules>
		<!-- Reduce routine framework noise -->
		<logger name="Microsoft.*"
				minlevel="Warn"
				writeTo="logfile,console"
				final="true" />

		<!-- Log application events from Info upwards -->
		<logger name="*"
				minlevel="Info"
				writeTo="logfile,console" />
	</rules>
</nlog>